#!/usr/bin/env python3
"""
Edge Clean Copilot — VS Code GitHub Copilot Local Toggle Tool
Quickly switch GitHub Copilot in VS Code between local/Spark LLMs and GitHub Cloud.
"""

import sys
import os
import json
from pathlib import Path

SETTINGS_PATH = Path.home() / ".config" / "Code" / "User" / "settings.json"
DEFAULT_SPARK_IP = "192.168.6.35"
COPILOT_PORT = "8085"
QWEN_PORT = "8080"

def load_settings() -> dict:
    if not SETTINGS_PATH.exists():
        return {}
    try:
        with open(SETTINGS_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        print(f"[ERROR] Could not parse {SETTINGS_PATH}: {e}", file=sys.stderr)
        sys.exit(1)

def save_settings(settings: dict) -> None:
    SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(SETTINGS_PATH, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2, ensure_ascii=False)
        f.write("\n")

def get_current_proxy(settings: dict) -> str | None:
    adv = settings.get("github.copilot.advanced")
    if isinstance(adv, dict):
        return adv.get("debug.overrideProxyUrl")
    return None

def cmd_status():
    settings = load_settings()
    proxy = get_current_proxy(settings)
    print("======================================================")
    print("  VS Code GitHub Copilot — Model Routing Status")
    print("======================================================")
    if proxy:
        target_name = "Edge Clean Copilot (Fine-tuned)" if COPILOT_PORT in proxy else ("Qwen3-Coder 30B" if QWEN_PORT in proxy else "Custom Local LLM")
        print(f"  Status   : 🟢 ACTIVE (Routing to Private/Edge LLM)")
        print(f"  Endpoint : {proxy}")
        print(f"  Target   : {target_name}")
    else:
        print(f"  Status   : ⚪ CLOUD DEFAULT (GitHub Copilot Official Cloud)")
        print(f"  Endpoint : https://api.githubcopilot.com")
    print("======================================================")

def cmd_on(target: str = "copilot", host: str = DEFAULT_SPARK_IP):
    port = COPILOT_PORT if target == "copilot" else QWEN_PORT
    model_name = "Edge Clean Copilot 1.5B (Port 8085)" if target == "copilot" else "Qwen3-Coder 30B (Port 8080)"
    endpoint = f"http://{host}:{port}"

    settings = load_settings()
    if "github.copilot.advanced" not in settings or not isinstance(settings["github.copilot.advanced"], dict):
        settings["github.copilot.advanced"] = {}

    settings["github.copilot.advanced"]["debug.overrideProxyUrl"] = endpoint
    save_settings(settings)

    print(f"\n[OK] GitHub Copilot in VS Code switched to: 🟢 LOCAL/SPARK")
    print(f"     Target Model: {model_name}")
    print(f"     Endpoint    : {endpoint}")
    print(f"\n[TIP] Restart or reload VS Code window ('Developer: Reload Window') for immediate effect.")

def cmd_off():
    settings = load_settings()
    if "github.copilot.advanced" in settings and isinstance(settings["github.copilot.advanced"], dict):
        settings["github.copilot.advanced"].pop("debug.overrideProxyUrl", None)
        if not settings["github.copilot.advanced"]:
            settings.pop("github.copilot.advanced", None)
        save_settings(settings)

    print(f"\n[OK] GitHub Copilot in VS Code switched to: ⚪ GITHUB CLOUD (Default)")
    print(f"\n[TIP] Reload VS Code window ('Developer: Reload Window') to reconnect to cloud.")

def show_help():
    print("""Usage: copilot-local <command> [options]

Fast toggle for VS Code GitHub Copilot between Local/Spark LLMs and GitHub Cloud.

Commands:
  on [copilot|qwen] [host]  Redirect Copilot to private LLM (default: copilot on 192.168.6.35:8085)
  off                       Restore official GitHub Copilot Cloud
  status                    Show current routing status in VS Code settings

Examples:
  copilot-local on          # Switch to Edge Clean Copilot on Spark (Port 8085)
  copilot-local on qwen     # Switch to Qwen3-Coder 30B on Spark (Port 8080)
  copilot-local on copilot 127.0.0.1  # Switch to local laptop endpoint
  copilot-local off         # Revert back to GitHub Cloud
  copilot-local status      # Check current active configuration
""")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        show_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()
    if cmd == "status":
        cmd_status()
    elif cmd == "on":
        target = sys.argv[2].lower() if len(sys.argv) > 2 else "copilot"
        host = sys.argv[3] if len(sys.argv) > 3 else DEFAULT_SPARK_IP
        if target not in ("copilot", "qwen"):
            host = target
            target = "copilot"
        cmd_on(target, host)
    elif cmd == "off":
        cmd_off()
    else:
        print(f"[ERROR] Unknown command: '{cmd}'", file=sys.stderr)
        show_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
