#!/usr/bin/env python3
"""
Edge Clean Copilot — VS Code GitHub Copilot Local Toggle Tool
Quickly switch GitHub Copilot in VS Code between local/Spark LLMs and GitHub Cloud,
and manage local offline inference servers on the laptop.
"""

import sys
import os
import subprocess
import json
import signal
from pathlib import Path

SETTINGS_PATH = Path.home() / ".config" / "Code" / "User" / "settings.json"
REPO_ROOT = Path(__file__).resolve().parent.parent
LOCAL_MODEL_PATH = REPO_ROOT / "models" / "clean-copilot-1.5b-q4_k_m.gguf"
PID_FILE = Path.home() / ".local" / "share" / "clean-copilot-server.pid"
LOG_FILE = Path.home() / ".local" / "share" / "clean-copilot-server.log"

DEFAULT_SPARK_IP = "192.168.6.35"
COPILOT_PORT = "8085"
QWEN_PORT = "8080"

def load_settings() -> dict:
    if not SETTINGS_PATH.exists():
        return {}
    try:
        with open(SETTINGS_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        print(f"[ERROR] Could not parse {SETTINGS_PATH}: {e}", file=sys.stderr)
        sys.exit(1)

def save_settings(settings: dict) -> None:
    SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(SETTINGS_PATH, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2, ensure_ascii=False)
        f.write("\n")

def get_current_proxy(settings: dict) -> str | None:
    adv = settings.get("github.copilot.advanced")
    if isinstance(adv, dict):
        return adv.get("debug.overrideProxyUrl")
    return None

def is_local_server_running() -> int | None:
    if not PID_FILE.exists():
        return None
    try:
        pid = int(PID_FILE.read_text().strip())
        os.kill(pid, 0)
        return pid
    except (ValueError, ProcessLookupError, PermissionError):
        PID_FILE.unlink(missing_ok=True)
        return None

def cmd_start_server():
    pid = is_local_server_running()
    if pid:
        print(f"[Edge Clean Copilot] Local server is already running (PID: {pid}) at http://127.0.0.1:{COPILOT_PORT}")
        return

    if not LOCAL_MODEL_PATH.exists():
        print(f"[ERROR] Local model binary not found at: {LOCAL_MODEL_PATH}", file=sys.stderr)
        sys.exit(1)

    PID_FILE.parent.mkdir(parents=True, exist_ok=True)
    llama_server_bin = Path.home() / ".local" / "bin" / "llama-server"

    cmd = [
        str(llama_server_bin),
        "-m", str(LOCAL_MODEL_PATH),
        "--port", COPILOT_PORT,
        "--host", "127.0.0.1",
        "--alias", "clean-copilot,edge-clean-copilot-q4_k_m",
        "-c", "4096",
        "--jinja"
    ]

    print(f"--> Starting local offline inference server on laptop CPU (Port {COPILOT_PORT})...")
    with open(LOG_FILE, "w") as log:
        proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)

    PID_FILE.write_text(str(proc.pid))
    print(f"[OK] Local server started with PID {proc.pid}.")
    print(f"     Endpoint: http://127.0.0.1:{COPILOT_PORT}")
    print(f"     Log file: {LOG_FILE}")

def cmd_stop_server():
    pid = is_local_server_running()
    if not pid:
        print("[Edge Clean Copilot] No local server is currently running.")
        return

    try:
        os.kill(pid, signal.SIGTERM)
        print(f"[OK] Stopped local server (PID: {pid}).")
    except Exception as e:
        print(f"[WARN] Error terminating process {pid}: {e}")
    PID_FILE.unlink(missing_ok=True)

def cmd_status():
    settings = load_settings()
    proxy = get_current_proxy(settings)
    local_pid = is_local_server_running()

    print("======================================================")
    print("  VS Code GitHub Copilot — Model Routing Status")
    print("======================================================")
    if proxy:
        target_name = "Edge Clean Copilot (Fine-tuned)" if COPILOT_PORT in proxy else ("Qwen3-Coder 30B" if QWEN_PORT in proxy else "Custom Local LLM")
        print(f"  Routing  : 🟢 ACTIVE (Routing to Private/Edge LLM)")
        print(f"  Endpoint : {proxy}")
        print(f"  Target   : {target_name}")
    else:
        print(f"  Routing  : ⚪ CLOUD DEFAULT (GitHub Copilot Official Cloud)")
        print(f"  Endpoint : https://api.githubcopilot.com")

    print("------------------------------------------------------")
    if local_pid:
        print(f"  Local CPU Server : 🟢 RUNNING (PID: {local_pid}, Port: {COPILOT_PORT})")
    else:
        print(f"  Local CPU Server : ⚪ INACTIVE (Run 'copilot-local start-server' to launch)")
    print("======================================================")

def cmd_on(target: str = "copilot", host: str = DEFAULT_SPARK_IP):
    if target == "local":
        host = "127.0.0.1"
        target = "copilot"
    port = COPILOT_PORT if target == "copilot" else QWEN_PORT
    model_name = "Edge Clean Copilot 1.5B (Port 8085)" if target == "copilot" else "Qwen3-Coder 30B (Port 8080)"
    endpoint = f"http://{host}:{port}"

    settings = load_settings()
    if "github.copilot.advanced" not in settings or not isinstance(settings["github.copilot.advanced"], dict):
        settings["github.copilot.advanced"] = {}

    settings["github.copilot.advanced"]["debug.overrideProxyUrl"] = endpoint
    save_settings(settings)

    print(f"\n[OK] GitHub Copilot in VS Code switched to: 🟢 LOCAL/SPARK")
    print(f"     Target Model: {model_name}")
    print(f"     Endpoint    : {endpoint}")
    print(f"\n[TIP] Reload VS Code window ('Developer: Reload Window') for immediate effect.")

def cmd_off():
    settings = load_settings()
    if "github.copilot.advanced" in settings and isinstance(settings["github.copilot.advanced"], dict):
        settings["github.copilot.advanced"].pop("debug.overrideProxyUrl", None)
        if not settings["github.copilot.advanced"]:
            settings.pop("github.copilot.advanced", None)
        save_settings(settings)

    print(f"\n[OK] GitHub Copilot in VS Code switched to: ⚪ GITHUB CLOUD (Default)")
    print(f"\n[TIP] Reload VS Code window ('Developer: Reload Window') to reconnect to cloud.")

def show_help():
    print("""Usage: copilot-local <command> [options]

Fast toggle for VS Code GitHub Copilot and offline laptop inference.

VS Code Routing:
  on [copilot|qwen|local]   Redirect Copilot (default: copilot on Spark 192.168.6.35:8085)
  on local                  Redirect Copilot to 100% offline laptop CPU (127.0.0.1:8085)
  off                       Restore official GitHub Copilot Cloud
  status                    Show current routing & local server status

Local Offline Engine (on Laptop CPU):
  start-server              Launch background llama-server on laptop CPU with local GGUF
  stop-server               Stop background local llama-server

Examples:
  copilot-local on            # Route VS Code to Spark GPU
  copilot-local start-server  # Launch local model on laptop
  copilot-local on local      # Route VS Code to local offline laptop model
  copilot-local off           # Return to GitHub Cloud
""")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        show_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()
    if cmd == "status":
        cmd_status()
    elif cmd in ("start-server", "start"):
        cmd_start_server()
    elif cmd in ("stop-server", "stop"):
        cmd_stop_server()
    elif cmd == "on":
        target = sys.argv[2].lower() if len(sys.argv) > 2 else "copilot"
        host = sys.argv[3] if len(sys.argv) > 3 else DEFAULT_SPARK_IP
        if target not in ("copilot", "qwen", "local"):
            host = target
            target = "copilot"
        cmd_on(target, host)
    elif cmd == "off":
        cmd_off()
    else:
        print(f"[ERROR] Unknown command: '{cmd}'", file=sys.stderr)
        show_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
